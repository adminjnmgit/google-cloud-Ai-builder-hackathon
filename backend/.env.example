# Copy to backend/.env and edit. .env is git-ignored; never commit real credentials.

# The one MySQL/MariaDB database. The defaults match a stock XAMPP install.
# The application's tables are prefixed orbit_ and live beside the newsroom tables (jagran_biz ...).
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=jagran_orbit
# Cloud SQL names may include hyphens, e.g. example-prod-db. Quote the password if it contains # or spaces.
# On Cloud Run, attach the instance and set one of these instead of MYSQL_HOST:
# MYSQL_UNIX_SOCKET=/cloudsql/PROJECT:REGION:INSTANCE
# CLOUD_SQL_CONNECTION_NAME=PROJECT:REGION:INSTANCE

# The test suite uses its own schema on the same server. It must end in _test.
# MYSQL_TEST_DATABASE=jagran_orbit_test

# Where the pipeline reads reports: the MySQL table below, or a CSV export.
ORBIT_SOURCE_TABLE=jagran_biz
# ORBIT_SOURCE_CSV=C:\path\to\Jagran Biz - Sheet1.csv

# Also read offline machine translations (tools/translate_hindi.py) for articles that have no English.
ORBIT_USE_MACHINE_TRANSLATIONS=0

# Protects /api/admin/* (pipeline runs). When empty, only requests from this machine are accepted.
ORBIT_ADMIN_TOKEN=

# How many successful pipeline runs to keep (older ones are deleted).
ORBIT_KEEP_RUNS=3
# Largest CSV upload accepted by the admin API, in MB.
ORBIT_MAX_UPLOAD_MB=80
# Set to 1 when serving over HTTPS so the workspace cookie is marked Secure.
ORBIT_COOKIE_SECURE=0
# Apply Alembic migrations when the process starts (use 1 on Cloud Run).
ORBIT_MIGRATE_ON_START=0
